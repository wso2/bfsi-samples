<!--
    Overrides the container default of "Carbon,CXF3".

    This application is a self-contained third party client: every library it needs, CXF
    included, ships in WEB-INF/lib, and it calls no Carbon or Identity Server API. Attaching it
    to the shared Carbon and CXF3 environments would put it on classloaders that the Identity
    Server's own web applications share, so redeploying it can disturb them - the
    authentication endpoint loses the classpath its JSPs are compiled against, and its login
    and OAuth response pages start failing to compile.

    Requesting only the Tomcat environment keeps this application on its own classloader.
  -->
<Classloading xmlns="http://wso2.org/projects/as/classloading">

    <ParentFirst>false</ParentFirst>

    <Environments>Tomcat</Environments>
</Classloading>
